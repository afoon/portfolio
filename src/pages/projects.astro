---
import BaseLayout from "../layouts/BaseLayout.astro";
import WorkInProgress from "../components/WorkInProgress"
---

<BaseLayout>
    <div class="liquid-glass heading-wrapper">
        <h1 class="text-h1 project-heading">
            Projects
        </h1>
    </div>
    <WorkInProgress/>
</BaseLayout>

<style>
    .project-heading {
        padding: 4px 32px;
    }
    .heading-wrapper{
        text-align: center;
        max-width: fit-content;
        margin-right: auto;
        margin-left: auto;
    }
</style>