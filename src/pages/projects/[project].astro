---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/globals/Badge';
import { imageConfig } from 'astro:assets';
import { Image } from 'astro:assets';
import styles from '../../styles/Project.module.css'
import Link from '../../components/globals/Link.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { project: project.id },
    props: { project },
  }));
}

const {project} = Astro.props
const {Content} = await render(project)
---
<BaseLayout>
<div class={styles.project}>
  <h1>{project.data.title}</h1>
  <p class="subtitle-1">{project.data.description}</p>
  <div class={styles.imageWrapper}>
    <img src={project.data.image.src} alt={project.data.image.alt}/>
  </div>
  <div class={styles.body}>
    <aside class="liquid-glass">
      <b class="text-h4">Tech Stack</b>
      <div class={styles.skills}>
        {project.data.skills.map( skill => <Badge skill={skill}/>)}
      </div>
      { project.data?.link && <Link>Live site <i class='bx  bx-link-external'></i> </Link>}
      {project.data?.code && <Link>Code Repo <i class='bxl bx-github'></i></Link>}
    </aside>
    <section>
      <Content/>
    </section>
  </div>
</div>
</BaseLayout>