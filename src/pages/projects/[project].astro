---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Badge from '../../components/globals/Badge';
import { imageConfig } from 'astro:assets';
import { Image} from 'astro:assets';
import type { ImageMetadata } from 'astro';
import styles from '../../styles/Project.module.css'
import Link from '../../components/globals/Link.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map(project => ({
    params: { project: project.id },
    props: { project },
  }));
}

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/**/*.{jpeg,jpg,png,gif}"
);

const {project} = Astro.props
const {link, code} = project?.data
const {Content} = await render(project)
---
<BaseLayout title={project.data.title}>
<div class={styles.project}>
  <h1>{project.data.title}</h1>
  <p class="subtitle-1">{project.data.description}</p>
  <div class={styles.imageWrapper}>
    <Image class={styles.image} src={images[project.data.image.src]()} alt={project.data.image.alt}/>
  </div>
  <div class={styles.body}>
    <aside class="liquid-glass">
      <b class="text-h4">Tech Stack</b>
      <div class={styles.skills}>
        {project.data.skills.map( skill => <Badge skill={skill}/>)}
      </div>
      { link && <Link url={link ?? ''} target>Live site <i class='bx  bx-link-external'></i> </Link>}
      {code && <Link url={code ?? ''}target >Code Repo <i class='bxl bx-github'></i></Link>}
    </aside>
    <section>
      <Content/>
    </section>
  </div>
</div>
</BaseLayout>