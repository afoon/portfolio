---
import Link from "../components/globals/Link.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroImage from "../components/LandingPage/HeroImage.astro";
import "../styles/landing.css";
import Flex from "../components/globals/Flex.astro";
import TextGradient from "../components/globals/TextGradient.astro";
---

<BaseLayout>
  <div class="section-hero">
    <Flex wrap="wrap-reverse" align="center">
      <div class="hero-content-wrapper">
        <Flex wrap="wrap" direction="column" class="hero-content liquid-glass">
          <h1 class="text-display hero-heading">
            <TextGradient>
				Hello!
				<br />
				My name is Amina
			</TextGradient>
          </h1>
          <div class="subtitle-1 hero-subtitle">
            I am a <TextGradient> fullstack</TextGradient> software
            engineer 👩🏾‍💻. My portfolio is currently under construction 🚧 . In the
            meantime, you can check me out on <Link
              url="https://github.com/afoon"
              >github<i class="bxl bx-github"></i>
            </Link> and <Link url="https://www.linkedin.com/in/aminata-foon/"
              >linkedin<i class="bxl bx-linkedin-square"></i>
            </Link>.
          </div>
          <Link variant="button" url="mailto:me@aminatafoon.com">
            Contact Me
          </Link>
        </Flex>
      </div>
      <HeroImage />
    </Flex>
  </div>
</BaseLayout>
