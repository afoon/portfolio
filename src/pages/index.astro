---
import Link from "../components/globals/Link.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroImage from "../components/LandingPage/HeroImage.astro";
import "../styles/landing.css";
import SocialLink from "../components/globals/SocialLink.jsx";
---

<BaseLayout title="Home">
  <div class="section-hero">
    <div class="flex-wrapper">
      <div class="hero-content-wrapper">
        <div class="hero-content">
          <div class="hero-heading">
            <h1 class="text-display hero-title">
              Hello! 👋
              <br />
              My name is <mark>Amina</mark>
            </h1>
            <h2 class="hero-subtitle">
              I am a frontend software engineer with 7+ years of experience at
              startups and civic tech.
            </h2>
          </div>
          <div class="hero-cta">
            <Link
              variant="button"
              noHover
              outline
              url="mailto:me@aminatafoon.com"
            >
              Get in touch
            </Link>
            <Link variant="button" noHover url="/projects">
              View Projects
            </Link>
          </div>
          <div class="social-links">
            <SocialLink href="https://github.com/afoon" icon="github"               
            bgColor="var(--color-bg-light)"
            color="var(--color-blue-950)" />
            <SocialLink
              href="https://www.linkedin.com/in/aminata-foon/"
              icon="linkedin"
              iconSize="2rem"
            />
          </div>
        </div>
      </div>
      <HeroImage />
    </div>
  </div>
</BaseLayout>
