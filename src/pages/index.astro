---
import Link from "../components/globals/Link.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroImage from "../components/LandingPage/HeroImage.astro";
import "../styles/landing.css";
import Flex from "../components/globals/Flex.astro";
import TextGradient from "../components/globals/TextGradient";
---

<BaseLayout title="Home">
  <div class="section-hero">
    <Flex wrap="wrap-reverse" align="center">
      <div class="hero-content-wrapper">
        <Flex wrap="wrap" direction="column" class="hero-content liquid-glass">
          <h1 class="text-display hero-heading">
            <TextGradient>
				Hello!
				<br />
				My name is Amina
			</TextGradient>
          </h1>
          <div class="text-h2 hero-subtitle">
            I am a <TextGradient><b> frontend</b></TextGradient> software
            engineer 👩🏾‍💻  
            <br/>
            <div>
              <Link target
              url="https://github.com/afoon"
              ><i class="bxl bx-github"></i>
            </Link><Link target url="https://www.linkedin.com/in/aminata-foon/"
            ><i class="bxl bx-linkedin-square"></i>
          </Link>
        </div>
          </div>
          <Link variant="button" noHover outline url="mailto:me@aminatafoon.com">
            Contact Me
          </Link>
          <Link variant="button" noHover url="/projects">
            View my work
          </Link>
        </Flex>
      </div>
      <HeroImage />
    </Flex>
  </div>
</BaseLayout>
