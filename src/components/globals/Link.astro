---
const { url, variant, outline, noHover, target, ...rest } = Astro.props;
---

<span {...rest}>
  <div class:list={["link-container", { [variant]: variant, "hover": !noHover, "outline": outline }]}>
    <a class="link-text" target={target ? "_blank": ""} href={url}>
      <slot />
    </a>
  </div>
</span>

<style>
  .link-container {
  font-size: inherit;
  display: inline-block;
  font-weight: 600;
  margin: 0px;
  padding: 0px;
  cursor: pointer;
}

.link-text {
  line-height: inherit;
  color: inherit;
  text-decoration: none;
}


  .link-container.hover:hover {
  border-bottom: var(--color-primary) solid 2px;
  }

.button{
  background-color: var(--color-primary);
  min-width: 200px;
  border-radius: 8px;
  justify-content: center;
  align-items: center;
  height: 52px;
  padding: 8px 24px;
  font-size: var(--text-base);
  font-weight: var(--bold);
  transition: background-color .2s;
  display: flex;
	a {
		color: white;
	    text-decoration: none;
	}
}

.button.outline {
    background-color: transparent;
    border: currentColor 2px solid;
    a{
      color: var(--text-color-primary);
    }
}
.button:hover{
	backdrop-filter:blur(4px);
  background-color:rgb( from var(--color-primary) r g b / 0.5);
  border-bottom: transparent;
}
.outline:hover{
  border-bottom: 2px solid var(--text-color-primary);
  background-color:rgb( from var(--text-color-primary) r g b / 0.2);
}
</style>