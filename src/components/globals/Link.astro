---
const { url, variant, outline, noHover, target, ...rest } = Astro.props;
---

<span {...rest}>
  <div class:list={["link-container", { [variant]: variant, "hover": !noHover, "outline": outline }]}>
    <a class="link-text" target={target ? "_blank": ""} href={url}>
      <slot />
    </a>
  </div>
</span>

<style>
  .link-container {
  font-size: inherit;
  display: inline-block;
  font-weight: 600;
  margin: 0px;
  padding: 0px;
  cursor: pointer;
}

.link-text {
  line-height: inherit;
  color: inherit;
  text-decoration: none;
}



.button{
  background-color: var(--color-primary);
  min-width: 200px;
  border-radius: 24px;
  border: 2px solid var(--color-blue-950);
  display: flex;
  justify-content: center;
  align-items: center;
  height: 52px;
  padding: 8px 24px;
  font-size: var(--text-base);
  font-weight: var(--bold);
  gap: 10px;
  transition: background-color .2s;
  box-shadow: 2px 3px 0 1px var(--color-blue-950);
	a {
		color: white;
	    text-decoration: none;
	}
}

.button.outline {
    background-color: var(--color-bg-light);
    border: currentColor 2px solid;
    a{
      color: var(--text-color-primary);
    }
}
.button:hover{

  background-color:hsl( from var(--color-primary)  h calc(s + 10) calc(l - 10) );
}
.outline:hover{
  border-bottom: 2px solid var(--text-color-primary);
  background-color: hsl( from var(--text-color-primary) h s 90%);
}
</style>