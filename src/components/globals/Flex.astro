---
const {directon, wrap, styles, align, justify, class: className} = Astro.props
const flexDirection = directon ?? 'row'
const flexWrap = wrap ? wrap : 'nowrap'
const alignItems = align ?? ''
const flexJustify = justify ?? 'flex-start';
---
<style define:vars={{ flexDirection, flexWrap, alignItems, flexJustify}}>
    .baseClasses {
        display: flex;
        flex-direction: var(--flexDirection);
        flex-wrap: var(--flexWrap);
        align-items: var(--alignItems);
        justify-content: var(--flexJustify);
    }
</style>
<div class:list={['baseClasses', {[className]: className}]} style={{...styles}}>
    <slot/>
</div>