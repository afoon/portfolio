---
import TextGradient from "../globals/TextGradient";
---

<div class="logo-container">
  <b style="color: var(--color-blue-900)">amina<span style="color: var(--color-primary)">foon</span></b>
  <div class="svg-container">
    <img class="logo-overlap" src={"/src/assets/circles.svg"} />
  </div>
</div>

<style>
  .logo-container {
    display: flex;
    padding: 10px 40px;
    align-items: flex-start;
    font-size: var(--text-lg);
    border-radius: 25px;
    backdrop-filter: blur(5px);
    background: radial-gradient(
      rgba(255, 255, 255, 0.2) calc(99% - 1px),
      rgba(255, 255, 255, 0.4) calc(100% - 1px) 99%,
      rgba(255, 255, 255, 0)
    );
    outline: 1px solid rgba(255, 255, 255, 0.3);
    outline-offset: -1px;
  }
  .logo-overlap {
    object-fit: cover;
    width: 20px;
  }

  .svg-container {
    overflow: visible;
    max-width: 100%;
    height: auto;
  }
</style>
