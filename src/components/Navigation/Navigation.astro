---
import Link from "../globals/Link.astro";
import Logo from "./Logo.astro"
import './Navigation.css'
const {pathname} = Astro.url;
---

<nav class="nav">
  <div class="flex logo-nav">
    <Link  noHover url="/"><Logo/></Link>
    <div class="flex nav-wrapper">
      <div class="nav-bar-links">
        <Link class:list={["nav-link", {active: pathname === "/projects"}]} noHover url="/projects">
           Projects
        </Link>
        <Link class="nav-link" noHover url="mailto:me@aminatafoon.com">
          Contact
       </Link>
      </div>
      <button class="mobile hamburger" popovertarget="mobile">
        <i class="bx bx-menu icon"></i>
      </button>
      <div id="mobile" class="mobile mobile-menu" popover>
        <div class="nav-bar-links-mobile">
          <Link linkClass="nav-link-mobile" url="/">
            Home
          </Link>
          <Link linkClass="nav-link-mobile" url="/projects">
            Projects
          </Link>
         <Link linkClass="nav-link-mobile" url="mailto:me@aminatafoon.com">
            Contact
          </Link>
        </div>
      </div>
    </div>
  </div>
</nav>

